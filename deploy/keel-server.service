# keel-server systemd unit. Configure /etc/keel/keel.env before enabling.
# 설치: sudo install -m 0644 deploy/keel-server.service /etc/systemd/system/
#       sudo install -m 0600 deploy/keel.env.example /etc/keel/keel.env  (값을 채운다)
#       sudo install -m 0755 bin/keel-server /usr/local/bin/keel-server
#       sudo install -m 0755 bin/keel-agent-linux-amd64 bin/keel-agent-linux-arm64 /usr/local/lib/keel/
#       sudo install -m 0755 bin/keel-linux-* bin/keel-darwin-* bin/keel-windows-*.exe /usr/local/lib/keel/  (CLI downloads, make clis)
#       sudo systemctl daemon-reload && sudo systemctl enable --now keel-server
[Unit]
Description=keel PaaS server
Documentation=https://github.com/turin-dev/aven
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/keel/keel.env
ExecStart=/usr/local/bin/keel-server
Restart=always
RestartSec=3
# 데이터(SQLite, master.key, DB 백업)는 KEEL_DATA(/var/lib/keel)에 있다. /tmp(tmpfs)에 두면 재부팅 때 사라진다.
StateDirectory=keel
StateDirectoryMode=0700
LimitNOFILE=1048576
# 컨테이너가 계속 돌아가야 하므로 keel-server만 멈춘다(proxy·앱 컨테이너는 Docker restart 정책으로 산다).
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

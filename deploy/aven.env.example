# AVEN_* is the name to set. KEEL_* still works: Aven reads AVEN_* first and falls back to KEEL_* once per process.
# /etc/aven/aven.env (0600, root). 실제 값은 저장소에 넣지 않는다.
AVEN_DATA=/var/lib/aven
# API/UI listen address. A reverse proxy on this host can reach this loopback address.
AVEN_LISTEN=127.0.0.1:7070
AVEN_PUBLIC_URL=https://aven.example.com
AVEN_BASE_DOMAIN=example.com
# aven이 80/443을 직접 받는다(다른 reverse proxy가 앞에 있으면 127.0.0.1 + 다른 포트 + AVEN_TLS=off).
AVEN_PROXY_BIND=
AVEN_HTTP_PORT=80
AVEN_HTTPS_PORT=443
AVEN_TLS=auto
# aven 밖 컨테이너(호스트의 compose)로 보내는 도메인 upstream 허용 목록과 aven-proxy가 붙을 네트워크
# AVEN_EXTERNAL_UPSTREAMS=grafana-1:3000
# AVEN_PROXY_NETWORKS=keel-external
AVEN_ACME_EMAIL=
AVEN_PUBLIC_IPV4=
AVEN_PUBLIC_IPV6=
# 도메인별 공개 IPv6 풀(/64~/120). 있으면 도메인마다 이 대역의 /128을 하나씩 배정해 AVEN_IPV6_IFACE에 붙인다(deprecated, 출발 주소로 안 씀).
# 값이 있으면 노드 설정(PATCH /api/nodes/node_local의 ipv6_pool)보다 우선한다. 비우면 모든 도메인이 AVEN_PUBLIC_IPV6를 같이 쓴다.
# AVEN_IPV6_POOL=2001:db8:1:d::/80
# 주소를 붙일 인터페이스. 비우면 AVEN_PUBLIC_IPV6를 가진 인터페이스, 없으면 IPv6 기본 경로의 인터페이스.
# AVEN_IPV6_IFACE=eth0
# 이 노드(main)의 공개 진입 방식. direct(기본) | cloudflare_tunnel. 값이 있으면 노드 설정(PATCH /api/nodes/node_local)보다 우선한다.
# cloudflare_tunnel이면 새 도메인을 tls=off, trust_forwarded_proto=true로 만들고 TCP 프록시를 열지 않는다(공개 IP 없음).
# AVEN_INGRESS_MODE=direct
# 커스텀 도메인이 CNAME으로 가리킬 이 노드의 이름. 비우면 A/AAAA 레코드만 안내한다. DNS에 이 이름의 A+AAAA가 있어야 한다.
# AVEN_INGRESS_HOSTNAME=main.edge.example.com
# TCP 프록시 접속 호스트(AVEN_TCP_PROXY_DOMAIN과 AVEN_TCP_PROXY_PORT 변수, 화면의 host:port). 비우면 노드 tcp_hostname → 기본 도메인/주소 순서다.
# TCP 프록시 포트는 Docker publish라 ufw를 거치지 않는다. 막으려면 DOCKER-USER에 규칙을 넣는다.
# AVEN_TCP_PROXY_DOMAIN=aven.example.com
# 노드 간 사설망(mesh)의 이 노드 주소. 노드 간 통신을 쓸 때 실제 사설 IP로 설정한다.
AVEN_PRIVATE_ADDRESS=
AVEN_MESH=auto
# 내장 관리자 비밀번호(8자 이상, 매 기동 때 필요)
AVEN_ADMIN_PASSWORD=
AVEN_GITHUB_WEBHOOK_SECRET=
# GitHub 연결(OAuth App, callback: https://aven.example.com/api/github/oauth/callback). 연결하면 AVEN_GITHUB_TOKEN 대신 쓴다.
AVEN_GITHUB_CLIENT_ID=
AVEN_GITHUB_CLIENT_SECRET=
# 연결이 없을 때만 쓰는 대체 토큰(읽기 전용 fine-grained). 비워 두어도 된다.
AVEN_GITHUB_TOKEN=
AVEN_AGENT_BIN_DIR=/usr/local/lib/aven
AVEN_RAILPACK_BIN=/usr/local/bin/railpack
# 선택 사항: Aven on Aven(docs/selfhost.md). 보통은 어드민 › Owner · 초기 설정에서 정한다(새 설치는 aven 프로젝트가 자동으로 생긴다).
# 이 파일은 docker --env-file로도 읽으므로 값에 따옴표를 쓰지 않는다.
# AVEN_SELF_SERVICE=svc_0123456789abcdef
# AVEN_SELF_PROJECT=off
# AVEN_SELF_ENV_FILE=/etc/aven/aven.env
# 선택 사항: 모든 작업 공간을 관리할 계정 이메일 목록.
AVEN_SUPERADMINS=

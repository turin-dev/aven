                      ],
                      "set": {
                        "X-Forwarded-For": [
                          "{http.request.header.X-Aven-Client-Ip}"
                        ],
                        "X-Forwarded-Proto": [
                          "{http.request.header.X-Aven-Client-Proto}"
                        ]
                      }
                    }
